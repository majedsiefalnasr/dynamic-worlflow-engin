# Backend API base.
# Relative `/api/v1` → goes through the Vite dev proxy (see vite.config.ts),
# which forwards to the backend server-side and avoids CORS in local dev.
# Leave EMPTY to fall back fully to local mock/localStorage data.
VITE_API_BASE_URL=/api/v1

# Which screens use the live backend. Comma list of resource keys, or `*` for all.
# Empty = every screen stays on mock (login still goes live when BASE_URL is set).
# Keys: reference-data, organizations, teams, roles, banks, merchants, reports, audit, notifications, requests, workflows
# (users management is blocked on the backend — CR-06/CR-12)
VITE_API_RESOURCES=
